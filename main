import os
import requests
from moviepy.editor import VideoFileClip, TextClip, CompositeVideoClip

def video_indir():
    print("1. Arka plan videosu indiriliyor...")
    video_url = "https://mixkit.co"
    
    response = requests.get(video_url, stream=True)
    with open("arka_plan.mp4", "wb") as f:
        for chunk in response.iter_content(chunk_size=1024):
            if chunk:
                f.write(chunk)
    print("Arka plan videosu başarıyla indirildi.")

def video_olustur():
    print("2. Video düzenleme işlemi başlıyor...")
    if not os.path.exists("arka_plan.mp4"):
        print("Hata: Arka plan videosu bulunamadı!")
        return

    clip = VideoFileClip("arka_plan.mp4").subclip(0, 5)
    
    test_metni = "GitHub Actions\nOtomasyon Testi\nBasariyla Calisti!"
    
    # Font ismini Linux sunucularının doğrudan tanıdığı standart font yapıyoruz
    txt_clip = TextClip(
        test_metni, 
        fontsize=50, 
        color='white', 
        font='DejaVu-Sans',  # Standart Linux fontu
        method='caption', 
        size=(clip.w - 40, None)
    )
    
    txt_clip = txt_clip.set_pos('center').set_duration(5)
    final_video = CompositeVideoClip([clip, txt_clip])
    
    print("Video render ediliyor...")
    final_video.write_videofile(
        "cikti_video.mp4", 
        fps=24, 
        codec="libx264", 
        audio_codec="aac"
    )
    print("Video basariyla olusturuldu: cikti_video.mp4")

if __name__ == "__main__":
    try:
        video_indir()
        video_olustur()
    except Exception as e:
        print(f"Kritik Hata Meydana Geldi: {str(e)}")
        raise e
